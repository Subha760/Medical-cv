{
  "name": "medcv-web",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "node --import tsx tests/core.test.ts && node --import tsx tests/upgrade.test.ts",
    "test:pdf": "node --import tsx scripts/validate-pdfs.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts playwright.config.ts",
    "test:backend": "node --import tsx tests/backend.test.ts",
    "test:documents": "node --import tsx tests/documents.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "docx": "9.9.0",
    "jspdf": "^4.2.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "pg": "8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
